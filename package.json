{
  "name": "nodejs-openhab-rest-client",
  "version": "2.0.0",
  "description": "Node.js client for the openHAB REST API – same classes and methods as python-openhab-rest-client",
  "author": "Michael Christian Dörflinger <michaeldoerflinger93@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/Michdo93/nodejs-openhab-rest-client",
  "repository": {
    "type": "git",
    "url": "https://github.com/Michdo93/nodejs-openhab-rest-client.git"
  },
  "keywords": [
    "openhab",
    "smarthome",
    "iot",
    "rest",
    "api",
    "client",
    "home-automation",
    "sse",
    "server-sent-events"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "generate": "bash tools/generate.sh",
    "build": "node build.js",
    "test": "node --test test/*.test.mjs test/*.test.cjs",
    "prepublishOnly": "npm run build"
  },
  "type": "module",
  "bugs": "https://github.com/Michdo93/nodejs-openhab-rest-client/issues"
}
